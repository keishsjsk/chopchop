[Desktop Entry]
Type=Application
Name=QuickEdit
GenericName=Photo and video viewer
GenericName[ru]=Просмотр и редактор фото и видео
Comment=Light photo viewer and video player with quick editing
Comment[ru]=Лёгкий просмотрщик фото, плеер видео и быстрый редактор
Exec=quickedit %F
Icon=quickedit
Terminal=false
Categories=AudioVideo;Video;Graphics;Viewer;
MimeType=image/bmp;image/gif;image/heic;image/heif;image/jpeg;image/png;image/tiff;image/webp;video/mp2t;video/mp4;video/mpeg;video/quicktime;video/webm;video/x-flv;video/x-m4v;video/x-matroska;video/x-ms-wmv;video/x-msvideo;
StartupWMClass=quickedit
